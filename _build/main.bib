@article{WANG201962,
title = "Detection based visual tracking with convolutional neural network",
journal = "Knowledge-Based Systems",
volume = "175",
pages = "62 - 71",
year = "2019",
issn = "0950-7051",
doi = "https://doi.org/10.1016/j.knosys.2019.03.012",
url = "http://www.sciencedirect.com/science/article/pii/S0950705119301339",
author = "Yong Wang and Xinbin Luo and Lu Ding and Shan Fu and Xian Wei",
keywords = "Correlation filter, Convolutional neural network (CNN), Detection strategy",
abstract = "In this paper, we propose a detection strategy based visual object tracking algorithm. We employ multiple trackers using layers of deep convolutional neural network (CNN) features. Each tracker which is correlation filter based tracking framework tracks an object forwardly and then backwardly. By analyzing the forward and backward trajectories, we measure the robustness of tracking results. A detection strategy which is based on locally adaptive regression kernels (LARK) feature is carried out according to the robustness of tracking result. Target can be located from the provided candidates. Extensive experimental results show that the proposed method improves the accuracy and robustness of tracking, achieving state-of-the-art results on several recent benchmark datasets."
}

